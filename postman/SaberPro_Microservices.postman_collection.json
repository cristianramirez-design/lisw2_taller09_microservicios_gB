    {
      "name": "2. Validation Service (:8082)",
      "description": "Validación estructural invocada por REST.",
      "item": [
        {
          "name": "2.1 Validar pregunta válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{validation_service_url}}/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón de diseño permite agregar responsabilidades a un objeto de forma dinámica sin modificar su clase?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Decorator\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Factory Method\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Template Method\"\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"valid = true\", () => pm.expect(pm.response.json().valid).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Validar pregunta inválida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{validation_service_url}}/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Pregunta?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Sí\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Sí\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Todas las anteriores\"\n    }\n  ],\n  \"correctOptionId\": \"E\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"valid = false con errores\", () => { pm.expect(b.valid).to.eql(false); pm.expect(b.errors.length).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Consultar reglas de validación",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{validation_service_url}}/validate/rules"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Question Service (:8083)",
      "description": "Creación síncrona y envío a revisión asíncrono (202 Accepted + operationId).",
      "item": [
        {
          "name": "3.1 Crear pregunta válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón de diseño permite agregar responsabilidades a un objeto de forma dinámica sin modificar su clase?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Decorator\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Factory Method\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Template Method\"\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Persistida en DRAFT\", () => pm.expect(b.status).to.eql(\"DRAFT\"));",
                  "pm.collectionVariables.set(\"question_id\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Crear pregunta inválida (la validación falla)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Pregunta?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Sí\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Sí\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Todas las anteriores\"\n    }\n  ],\n  \"correctOptionId\": \"E\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 400\", () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test(\"Informa los errores\", () => pm.expect(b.errors.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Crear pregunta sin token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{question_service_url}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón de diseño permite agregar responsabilidades a un objeto de forma dinámica sin modificar su clase?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Decorator\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Factory Method\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Template Method\"\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Crear segunda pregunta válida (queda en DRAFT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué estilo arquitectónico organiza el sistema en servicios pequeños, autónomos y desplegables de forma independiente?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Monolito en capas\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Microservicios\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Cliente-servidor de dos capas\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Tubos y filtros\"\n    }\n  ],\n  \"correctOptionId\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"question2_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.5 Enviar pregunta a revisión (asíncrono)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions/{{question_id}}/submit"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera para dar tiempo al procesamiento asíncrono en RabbitMQ",
                  "setTimeout(() => {}, 800);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 202\", () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "pm.test(\"Devuelve operationId y estado PROCESSING\", () => { pm.expect(b.operationId).to.be.a(\"string\"); pm.expect(b.status).to.eql(\"PROCESSING\"); });",
                  "pm.collectionVariables.set(\"operation_id\", b.operationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Consultar resultado de la operación",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{question_service_url}}/operations/{{operation_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera para dar tiempo al procesamiento asíncrono en RabbitMQ",
                  "setTimeout(() => {}, 2500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Transición completada a PENDING_REVIEW\", () => { pm.expect(b.status).to.eql(\"COMPLETED\"); pm.expect(b.resultingState).to.eql(\"PENDING_REVIEW\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.7 Reenviar la misma pregunta a revisión (fallará en el Lifecycle)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions/{{question_id}}/submit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"La solicitud se acepta, aún no se sabe el resultado\", () => pm.expect(pm.response.json().status).to.eql(\"PROCESSING\"));",
                  "pm.collectionVariables.set(\"operation_id_fail\", pm.response.json().operationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "3.8 Consultar operación fallida",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{question_service_url}}/operations/{{operation_id_fail}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera para dar tiempo al procesamiento asíncrono en RabbitMQ",
                  "setTimeout(() => {}, 2500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"No se informa falsamente que se completó\", () => { pm.expect(b.status).to.eql(\"FAILED\"); pm.expect(b.message).to.include(\"no permitida\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3.9 Consultar pregunta",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{question_service_url}}/questions/{{question_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Proyección de estado = PENDING_REVIEW\", () => pm.expect(pm.response.json().status).to.eql(\"PENDING_REVIEW\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.10 Consultar operación inexistente",
          "request": {
