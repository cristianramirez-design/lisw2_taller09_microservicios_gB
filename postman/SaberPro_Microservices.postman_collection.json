  "item": [
    {
      "name": "1. User Service (:8081)",
      "description": "Autenticación síncrona (POST /auth/login).",
      "item": [
        {
          "name": "1.1 Login docente (credenciales válidas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{user_service_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"docente1\",\n  \"password\": \"docente1123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"authenticated = true y trae roles\", () => { pm.expect(b.authenticated).to.eql(true); pm.expect(b.user.roles).to.include(\"AUTHOR\"); });",
                  "pm.collectionVariables.set(\"token_docente\", b.token);",
                  "pm.collectionVariables.set(\"docente_id\", b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Login administrador",
          "request": {
