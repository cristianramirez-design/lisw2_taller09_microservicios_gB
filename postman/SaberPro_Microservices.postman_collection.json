    {
      "name": "7. Flujo de corrección (Question + Lifecycle)",
      "description": "Corregir una pregunta rechazada y volver a enviarla a revisión.",
      "item": [
        {
          "name": "7.1 Estado REJECTED con motivo registrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{lifecycle_service_url}}/lifecycle/{{question_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"REJECTED y motivo guardado\", () => { pm.expect(b.state).to.eql(\"REJECTED\"); pm.expect(b.comment).to.include(\"ambigua\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7.2 Corregir la pregunta rechazada",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions/{{question_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón de diseño permite añadir responsabilidades a un objeto en tiempo de ejecución envolviéndolo, sin modificar su clase original?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Decorator\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Abstract Factory\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Memento\"\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Vuelve a DRAFT\", () => pm.expect(pm.response.json().status).to.eql(\"DRAFT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "7.3 Reenviar a revisión tras la corrección",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions/{{question_id}}/submit"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera para dar tiempo al procesamiento asíncrono en RabbitMQ",
                  "setTimeout(() => {}, 500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set(\"operation_id_resubmit\", pm.response.json().operationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "7.4 Consultar la operación de reenvío",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{question_service_url}}/operations/{{operation_id_resubmit}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera para dar tiempo al procesamiento asíncrono en RabbitMQ",
                  "setTimeout(() => {}, 2500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Puede volver al proceso de revisión\", () => { pm.expect(b.status).to.eql(\"COMPLETED\"); pm.expect(b.resultingState).to.eql(\"PENDING_REVIEW\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7.5 Corregir una pregunta que está en revisión",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_docente}}"
              }
            ],
            "url": "{{question_service_url}}/questions/{{question_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"¿Qué patrón de diseño permite añadir responsabilidades a un objeto en tiempo de ejecución envolviéndolo, sin modificar su clase original?\",\n  \"options\": [\n    {\n      \"id\": \"A\",\n      \"text\": \"Decorator\"\n    },\n    {\n      \"id\": \"B\",\n      \"text\": \"Singleton\"\n    },\n    {\n      \"id\": \"C\",\n      \"text\": \"Abstract Factory\"\n    },\n    {\n      \"id\": \"D\",\n      \"text\": \"Memento\"\n    }\n  ],\n  \"correctOptionId\": \"A\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "7.6 Historial de transiciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{lifecycle_service_url}}/lifecycle/{{question_id}}/history"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"DRAFT→PENDING_REVIEW→IN_REVIEW→REJECTED→DRAFT→PENDING_REVIEW\", () => pm.expect(pm.response.json().map(h => h.toState)).to.eql([\"DRAFT\",\"PENDING_REVIEW\",\"IN_REVIEW\",\"REJECTED\",\"DRAFT\",\"PENDING_REVIEW\"]));"
                ]
              }
            }
          ]
        }
      ]
