    {
      "name": "4. Lifecycle Service (:8084)",
      "description": "Autoridad sobre estados y transiciones.",
      "item": [
        {
          "name": "4.1 Consultar estado de la pregunta",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{lifecycle_service_url}}/lifecycle/{{question_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado PENDING_REVIEW\", () => pm.expect(pm.response.json().state).to.eql(\"PENDING_REVIEW\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Aprobar una pregunta en DRAFT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{lifecycle_service_url}}/lifecycle/{{question2_id}}/transition",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetState\": \"APPROVED\",\n  \"changedBy\": \"admin\",\n  \"comment\": \"Intento inválido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Transición rechazada\", () => pm.expect(pm.response.json().message).to.include(\"DRAFT -> APPROVED\"));"
                ]
              }
            }
          ]
        },
